{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/uncensored-dev",
  "small_model": "ollama/uncensored-dev",
  "default_agent": "beast",
  "enabled_providers": ["ollama"],
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "uncensored-dev": {
          "name": "uncensored-dev",
          "options": {
            "num_ctx": 65536,
            "temperature": 0.6
          }
        }
      }
    }
  },
  "skills": {
    "paths": [".opencode/skills"]
  }
}
